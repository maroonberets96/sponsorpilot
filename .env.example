# Copy this file to .env and fill in your own values. .env is gitignored.

# --- Input files (in data/input/) ---
# Your base CV as a .docx. Any filename; point this at it.
CV_FILENAME=cv.docx
# UK sponsor-licence register .xlsx (only needed for UK jobs mode). Download the
# latest "Worker and Temporary Worker" list from gov.uk and drop it in data/input/.
SPONSOR_XLSX_FILENAME=Worker_and_Temporary_Worker.xlsx

# --- Job boards (jobs-first mode; at least one required) ---
# Adzuna - free key at https://developer.adzuna.com (works for UK and Canada)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Reed - free key at https://www.reed.co.uk/developers (UK only)
REED_API_KEY=your_reed_api_key
# Jooble - free key at https://jooble.org/api/about (used for Canada)
JOOBLE_API_KEY=your_jooble_api_key

# --- Job search tuning (optional) ---
# JOB_LOCATION=London          # UK search centre
# JOB_DISTANCE_MILES=20        # radius around JOB_LOCATION
# JOB_LOCATION_CA=Toronto      # Canada city; leave unset to search all of Canada

# --- LLM providers (OpenAI-compatible waterfall; at least one required) ---
# All speak the OpenAI protocol, so adding a provider is just a key. They are
# tried in order (config.LLM_ORDER) and fail over on rate limits / dead keys.
# Set as many as you have; spare keys for one provider go in _2 / _3 and are
# tried as extra fallbacks. Default model is gpt-oss-120b everywhere it is
# served (Gemini and OpenRouter free tier run their own).
GROQ_API_KEY=your_groq_api_key_here          # https://console.groq.com
CEREBRAS_API_KEY=your_cerebras_api_key_here   # https://cloud.cerebras.ai
GEMINI_API_KEY=your_gemini_api_key_here       # https://aistudio.google.com
HUGGINGFACE_API_KEY=your_hf_token_here        # https://huggingface.co/settings/tokens
NVIDIA_API_KEY=your_nvidia_api_key_here       # https://build.nvidia.com
OPENROUTER_API_KEY=your_openrouter_api_key    # https://openrouter.ai/keys
MISTRAL_API_KEY=your_mistral_api_key          # https://console.mistral.ai (activate free tier)
REQUESTY_API_KEY=your_requesty_api_key        # https://requesty.ai (free route to Nemotron 550B)
# Ollama Cloud: set a key for the hosted endpoint (no daemon needed), or leave
# it unset to use a local daemon after `ollama signin` (model ends with -cloud).
OLLAMA_API_KEY=your_ollama_cloud_api_key      # https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Spare keys (optional): GROQ_API_KEY_2, NVIDIA_API_KEY_2, OPENROUTER_API_KEY_2, ...

# --- Optional overrides (defaults in src/config.py) ---
# LLM_ORDER=groq,cerebras,gemini,huggingface,nvidia,openrouter,ollama
# NVIDIA_MATCH_MODEL=openai/gpt-oss-120b
# NVIDIA_WRITE_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: one honest sentence about your right to work, added to application
# emails for that country. Leave blank to not mention it. Examples:
# WORK_ELIGIBILITY_UK="I hold a UK Skilled Worker visa and am eligible to work in the UK."
# WORK_ELIGIBILITY_CA="I am a Canadian permanent resident and require no sponsorship."
WORK_ELIGIBILITY_UK=
WORK_ELIGIBILITY_CA=

# Optional: your phone's country code. Applications to countries with
# intl_phone enabled in config.py (Canada by default) show your number in
# international format, e.g. 07700 900123 -> +44 7700 900123.
PHONE_COUNTRY_CODE=
